# Copy this file to .env and fill in real values. Never commit .env itself.

# --- database ---
# Must use the psycopg v3 driver ("+psycopg"), not the old psycopg2 one.
# Local dev (matches docker-compose.yml's postgres service):
DATABASE_URL=postgresql+psycopg://photoshare:photoshare@localhost:5432/photoshare
POSTGRES_USER=photoshare
POSTGRES_PASSWORD=photoshare
POSTGRES_DB=photoshare
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- auth (fastapi-users) ---
# Required, no default - generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Used for JWT signing AND the password-reset/email-verification token secrets.
JWT_SECRET=change-me-to-a-long-random-string
JWT_LIFETIME_SECONDS=3600

# --- media (ImageKit) ---
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL=

# --- redis (cache-aside on /feed and /posts/{id}, celery broker + result backend) ---
# DB 0 for the cache, DB 1 for celery - separate logical DBs so a FLUSHDB on
# one doesn't wipe the other. Matches docker-compose.yml's redis service.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
FEED_CACHE_TTL_SECONDS=30
POST_CACHE_TTL_SECONDS=60

# --- cors / deployment ---
CORS_ALLOW_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]
ENVIRONMENT=development
